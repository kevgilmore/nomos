{
  "name": "nomos",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "nomos": "./cli/cli.mjs"
  },
  "scripts": {
    "nomos": "node cli/cli.mjs",
    "create:app": "node .agents/skills/new-app/scripts/create-app.mjs",
    "sync:apps": "node .agents/skills/new-app/scripts/sync-app-registry.mjs",
    "configure:dns": "node scripts/configure-dns.mjs",
    "dev": "node cli/cli.mjs dev",
    "dev:fitness": "pnpm --filter @nomos/fitness dev --port 3003",
    "dev:all": "node cli/cli.mjs dev",
    "build": "pnpm --filter @nomos/fitness build",
    "build:all": "pnpm --recursive --if-present build",
    "build:hosting": "node scripts/build-hosting.mjs",
    "classify:pan-p-gym": "node scripts/classify-pan-p-gym.mjs",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  }
}
